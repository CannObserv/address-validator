[Unit]
Description=Remove Docker build cache, stopped containers, dangling images, unused networks
After=docker.service
Requires=docker.service
OnFailure=unit-failure@%n.service

[Service]
Type=oneshot
User=exedev
# Tags docker-prune-check.sh warnings too; keeps `journalctl -t docker-prune`
SyslogIdentifier=docker-prune
ExecStart=/usr/bin/docker system prune -f
ExecStartPost=/home/exedev/address-validator/infra/docker-prune-check.sh

