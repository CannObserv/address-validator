[Unit]
Description=Address Validator (FastAPI)
After=network.target libpostal.service postgresql.service
Wants=libpostal.service

[Service]
Type=simple
User=exedev
WorkingDirectory=/home/exedev/address-validator
EnvironmentFile=/etc/address-validator/.env
EnvironmentFile=-/home/exedev/address-validator/.env
# Validation provider config (optional — defaults to none/unavailable):
#   VALIDATION_PROVIDER=usps
#   USPS_CONSUMER_KEY=<key from developer.usps.com>
#   USPS_CONSUMER_SECRET=<secret from developer.usps.com>
StateDirectory=address-validator
Environment=PYTHONPATH=/home/exedev/address-validator/src
# --log-config: route uvicorn's own access/error loggers through the app's JSON
# formatter (GH #185). Without it journald gets plain-text uvicorn lines mixed
# with JSON app records. Path is relative to WorkingDirectory.
ExecStart=/home/exedev/address-validator/.venv/bin/uvicorn address_validator.main:app --host 0.0.0.0 --port 8000 --log-config src/address_validator/core/log_config.json
Restart=on-failure
RestartSec=3

# Memory reservation (GH #214). This VM runs dev sessions beside this service on
# 7.2 GiB with no swap, and exe.dev session processes inherit oom_score_adj
# -1000 from exe-init/sshd -- the OOM killer can never pick a session, so under
# real exhaustion it takes this service instead. Steady state here is ~150 MB.
#   MemoryLow      soft floor: the kernel reclaims from this cgroup only after
#                  everything unprotected is exhausted. INERT ON ITS OWN --
#                  a cgroup's effective memory.low is bounded by its
#                  ancestors', and system.slice defaults to 0, so this line
#                  needs infra/system-slice-memory.conf installed to do
#                  anything at all. `systemctl show` reports the configured
#                  value either way; see docs/HOST-MEMORY.md
#                  for the check that reads the effective one.
#   OOMScoreAdjust makes this service a worse target than any unadjusted
#                  process. It cannot outrank a session at -1000; it does not
#                  need to, it needs to outrank the rest of the host.
# A cap on a session is not a substitute -- a cgroup cap on a process the killer
# will not touch stalls it rather than killing it (gregoryfoster/skills#295).
MemoryLow=512M
OOMScoreAdjust=-500

[Install]
WantedBy=multi-user.target
