# patching-hosts knob (#311). Grammar: skills/patching-hosts/references/knob.md.
# Read by the vendored skill; never written by it. Decisions pinned in
# tests/unit/test_patching_knob.py — change both together. Times are UTC.

class production
posture scheduled
cadence weekly

# Weekly, Thursday 18:00-21:00 UTC (decided 2026-11-06, #272/#311): runs are
# interactive, so they sit in Pacific working hours, 10:00-13:00 PST and
# 11:00-14:00 PDT. UTC, so DST moves the Pacific reading, never the window.
# A week with nothing pending ends at the probe (run.md).
window Thu 18:00-21:00

# Daily 02:30 address-validator-backup (#240; done by 02:45, its timeout),
# 03:00 audit-archive, 04:00 cache-sweep, 05:15 +30min cannobserv-disk-gc
# (Provisioner's, #326), 06:00 archive-age-check (After=audit-archive).
# cannobserv-disk-headroom.timer fires every 10 min, read-only like libpostal-probe;
# it isn't in infra/, so FREQUENT_PROBES doesn't list it.
# libpostal-probe.timer fires every 2 min and has no quiet range: a read-only
# liveness probe, declared in FREQUENT_PROBES (the test) with its sizing (#256).
quiet 02:30-06:15
# wslcb-licensing-tracker calls this host from timers on America/Los_Angeles
# time, so each range covers both UTC offsets (PDT -7, PST -8), 5 min before to
# 45 min after: its scraper's backfills at 00:30 and 06:30 PT (07:30/08:30 and
# 13:30/14:30 UTC) and its address validation at 02:00 PT (09:00/10:00 UTC).
quiet 07:25-10:45
quiet 13:25-15:15

# First start after boot once failed on a not-yet-ready dependency and
# Restart=on-failure recovered it (#239): --post-boot reads its NRestarts.
service address-validator.service
# Docker in the production path (CA parsing sidecar).
service libpostal.service
exception ordering:libpostal.service 2027-01-31 stateless parser sidecar; never touches Postgres, so no After= on it


# No journal:volatile exception: the journal persists since #241 (flush unmasked,
# 512M cap, infra/journald.conf.d/). The probe reads files under /var/log/journal,
# so a re-mask shows up as a finding again; so does tests/unit/test_journald_config.py.
# exe.dev sessions inherit -1000 from exe-init/sshd (docs/HOST-MEMORY.md); the
# skill runs the apply and dry run under choom -n 0.
exception session:adj 2027-01-31 platform session lineage; apply and dry run run under choom -n 0

# Liveness: 503 when degraded. Open route; libpostal state doesn't affect it.
health curl -sf -o /dev/null --max-time 10 http://localhost:8000/api/v2/health
health curl -sf -o /dev/null --max-time 10 'http://localhost:4400/parse?address=1+Main+St'
# Recovery, not liveness: the app fails open while Postgres is down (step 0,
# #235). One public address validated twice, both audit rows present, cache
# hit on the repeat. Exits 1 before any request while Postgres isn't accepting.
# A recovery line, not a health line: it writes audit rows and can spend a
# provider call, so it runs only after a step restarts Postgres and after the
# reboot, never on every probe (knob.md, gregoryfoster/skills#423).
recovery /home/exedev/address-validator/.venv/bin/python /home/exedev/address-validator/infra/patching_recovery_check.py

# Recovery point: the nightly backup (#240, docs/RECOVERY.md). recovery-point.sh
# starts it and needs that run to succeed, instead of writing its own dump,
# which would hold PII (audit_log.raw_input, raw client IPs) under $HOME.
datastore postgres postgresql@16-main address_validator
backup address-validator-backup.service postgresql@16-main
# The restarter scan matches the usage docstring ("by hand only through
# ``systemctl start``"), not a call: the backup starts and restarts nothing.
exception not-restarter:address-validator-backup.service 2027-01-31 backup_db.py:39 is its usage docstring, not a call; the backup restarts nothing (#240)
exception database:address_validator_test 2027-01-31 test fixtures only; rebuilt by alembic upgrade head on every test run
exception database:address_validator_test_rehearsal 2027-01-31 the backup rehearsal's restore target; emptied and reloaded by every test run (#240)

# nginx shipped with the exeuntu image (2026-02-18 build), never served a
# request (empty logs since), and its default site listened on :8000. Purged
# 2026-10-30 (#319); nginx.service stays masked so a reinstall can't start.
# Drift from the image: the line stays while the image ships nginx.
exception purged:nginx 2027-01-31 exeuntu image leftover, never used; default site bound :8000 (#319)

# Third-party apt origins, maintenance lane. Scoped by pins in
# /etc/apt/preferences.d/ (policy.md "Two lanes").
origin deb.nodesource.com follow
# The tailnet hop to notifier (docs/TAILNET.md): its own held step, so the
# drop of that path is approved on its own.
origin pkgs.tailscale.com follow
hold tailscale tailscale

# Synchronous callers, told before a restart (window, outage, what they get).
caller CannObserv/power-map
caller CannObserv/wslcb-licensing-tracker
# A third caller's repo is private: told by hand, name kept out of this public
# repo (gregoryfoster/skills#350). image-owner left out for the same reason.
